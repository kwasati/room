import Layout from '../../layouts/Layout.astro';

// content port จาก intensivetrader.com/src/pages/ea/gdbasket.astro (เดิม)
const MAIN = 'https://intensivetrader.com';
const JOURNAL = 'https://journal.intensivetrader.com/';
const DL_LATEST = `${MAIN}/d/gdbasket`; // ปุ่มหลัก — redirect ชี้ไฟล์รุ่นล่าสุด v3.11 (publish/releases/v3.11/gdBasket_v3.11.ex5)
const DL_V310 = `${MAIN}/d/gdbasket-v310`;
const DL_V3092 = `${MAIN}/d/gdbasket-v3092`;
const DL_V202 = `${MAIN}/d/gdbasket-v202`;
const DL_V201 = `${MAIN}/d/gdbasket-v201`;
const DL_V200 = `${MAIN}/d/gdbasket-v200`;
const DL_V137 = `${MAIN}/d/gdbasket-v137`;
const DL_V118 = `${MAIN}/d/gdbasket-v118`;
const XM_AFF = 'https://affs.click/jih0m';
const XM_CODE = 'KWASATI';
const VPS_AFF = 'https://bit.ly/MTCloudVPS';
const COPYTRADE_URL = 'https://social.tp-redirect.com/s/0mYnzepR';

// Myfxbook — ดึงทุกพอร์ต live จาก /api/myfxbook.json ตอน build + fallback ต่อบัญชีกันพัง
// client script ท้ายไฟล์ refresh ค่าสดตอน runtime + clone การ์ดเพิ่มเองเมื่อ API คายพอร์ตใหม่ ไม่ต้องแก้ไฟล์นี้อีก
type MfbCard = {
  id: string; name: string; label: string; url: string | null; newNote: string | null;
  gain: string | null; absGain: string | null; monthly: string | null; drawdown: string | null; balance: string | null;
};
const mfbSlug = (s: string) => (s || 'account').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const mfbFallback: MfbCard[] = [
  { id: '12090186', name: 'gdbasket-xs', label: 'พอร์ต 1', url: 'https://www.myfxbook.com/members/kwasati/gdbasket-xs/12090186', newNote: null, gain: '53.40', absGain: '53.45', monthly: '53.40', drawdown: '18.16', balance: '460.36' },
  { id: '12105756', name: 'gdbasket lx', label: 'พอร์ต 2', url: 'https://www.myfxbook.com/members/kwasati/gdbasket-lx/12105756', newNote: 'พอร์ตใหม่ เริ่ม 2026-07', gain: null, absGain: null, monthly: null, drawdown: null, balance: null },
];
let mfbCards: MfbCard[] = mfbFallback;
try {
  const raw = await fetch('https://www.intensivetrader.com/api/myfxbook.json').then((r) => r.json());
  // API รุ่นเก่าคาย object พอร์ตเดียว (ไม่มี id/name) — แปลงเป็น array โดยถือเป็นพอร์ต 1; รุ่นใหม่คาย array ทุกพอร์ต live
  const accounts = Array.isArray(raw) ? raw : (raw && raw.gain != null ? [{ id: mfbFallback[0].id, name: mfbFallback[0].name, ...raw }] : []);
  if (accounts.length > 0) {
    const f = (n: unknown) => (n == null ? null : Number(n).toFixed(2));
    const toCard = (acc: any, base: MfbCard): MfbCard => ({
      ...base,
      id: String(acc.id),
      name: acc.name || base.name,
      url: `https://www.myfxbook.com/members/kwasati/${mfbSlug(acc.name || base.name)}/${acc.id}`,
      newNote: null,
      gain: f(acc.gain), absGain: f(acc.absGain), monthly: f(acc.monthly), drawdown: f(acc.drawdown), balance: f(acc.balance),
    });
    const used = new Set<string>();
    mfbCards = mfbFallback.map((fb) => {
      const acc = accounts.find((a: any) => String(a.id) === fb.id || (a.name || '').toLowerCase() === fb.name.toLowerCase());
      if (!acc) return fb; // fallback ต่อบัญชี — API ยังไม่คืนพอร์ตนี้
      used.add(String(acc.id));
      return toCard(acc, fb);
    });
    // พอร์ตใหม่ที่ยังไม่รู้จัก — ต่อท้ายเป็นการ์ดเพิ่ม
    for (const acc of accounts) {
      if (!used.has(String(acc.id))) mfbCards.push(toCard(acc, { id: '', name: '', label: `พอร์ต ${mfbCards.length + 1}`, url: null, newNote: null, gain: null, absGain: null, monthly: null, drawdown: null, balance: null }));
    }
  }
} catch (e) { /* ใช้ fallback */ }

const features = [
  { title: 'Adaptive Grid Behavior', desc: 'ตรวจจับว่าราคาอยู่โซนไหน แล้วปรับระยะ Grid และขนาด Lot ให้เหมาะกับสถานการณ์ ตลาดเป็นใจจะเปิดโอกาสให้กำไรโตขึ้น ตลาดไม่เป็นใจจะเปลี่ยนมาเล่นอย่างระมัดระวังมากขึ้น', tag: 'ปรับ Grid + Lot ตามโซนราคา' },
  { title: 'Market Temperature', desc: 'วัดความร้อนของตลาดก่อนเปิดรอบใหม่ ถ้าความผันผวนอันตรายเกินเกณฑ์ ระบบจะงดเข้าเทรดและรอให้ตลาดกลับมาเหมาะสมกว่า', tag: 'กรองอันตรายก่อนเริ่มกอง' },
  { title: 'PPTS', desc: 'เมื่อราคาเดินถูกทาง ระบบจะค่อยๆ เติมไม้เพื่อเพิ่มโอกาสทำกำไร พร้อมไล่ล็อกกำไรรวมของทั้งชุด ให้กำไรวิ่งต่อโดยไม่ปล่อยของที่เก็บมาแล้วไหลกลับมากเกินไป', tag: 'เติมไม้ขาขึ้น + ไล่ล็อกกำไร' },
];

const howSteps = [
  '<strong class="text-gray-light">เริ่มรอบเมื่อสภาพตลาดเหมาะ</strong> ระบบดูอุณหภูมิตลาดก่อน ไม่รีบเปิดกองในจังหวะที่อันตรายเกินเกณฑ์',
  '<strong class="text-gray-light">อ่านโซนราคา</strong> ปรับวิธีวาง Grid และขนาด Lot ตามตำแหน่งราคาและความเหวี่ยงของตลาด',
  '<strong class="text-gray-light">ราคาลง ระบบทยอยซื้อ</strong> วางไม้เพิ่มตามระยะที่คำนวณไว้ เพื่อขยับราคาเฉลี่ยของทั้งกอง',
  '<strong class="text-gray-light">ราคาขึ้น ระบบเติมกำไร</strong> PPTS เติมไม้ตามทาง พร้อมไล่ล็อกกำไรรวมขึ้นไป',
  '<strong class="text-gray-light">ปิดทั้งชุด</strong> เมื่อราคาแตะ Common-TP โบรกจะปิดทุกไม้ในรอบพร้อมกัน',
];

// "กว่าจะมาเป็น VELOCE" — 5 ขั้น (ย่อ story 5 บท)
const veloceSteps = [
  'ลองมาแล้วแทบทุกทาง — ปรับขนาดไม้ตามความผันผวน / อ่านอารมณ์ตลาดสลับโหมด / กรองก่อนเข้าไม้ / กู้กองตอนราคาไหลแรง — <strong class="text-gray-light">ตัดทิ้งทุกอันที่พิสูจน์แล้วว่าไม่ช่วยจริง</strong>',
  'เหลือ <strong class="text-gray-light">2 บ้าน</strong>ที่พิสูจน์แล้วว่าคุ้ม — เคยลองตัดบ้านล่างทิ้งเพราะกลัวมันทำให้ล้างพอร์ตบ่อย พอลองจริงกำไรหายไปเกินสามในสี่ส่วน จึงรู้ว่าตัดออกไม่ได้',
  'จุดเปลี่ยนสำคัญที่สุด: คุม <strong class="text-gray-light">"เวลาอมกอง"</strong> ไม่ใช่เดาวันร้าย — วันตลาดดิ่งแรงจนไม่เด้งเป็นสิ่งที่คุมไม่ได้ แต่ปิดรอบให้ไวที่สุดคุมได้ ยิ่งมือว่างมาก ยิ่งรอด',
  'เคาะแชมป์บนสนามทดสอบยาว 3 ปี 6 เดือน — สูตรที่ชนะทุกด้านพร้อมกัน กำไรมากกว่าสูตรก่อนหน้า และจำนวนครั้งที่ล้างพอร์ตน้อยกว่าเกือบครึ่ง',
  'ตรึงเป็นค่าตั้งต้น = <strong class="text-gray-light">VELOCE</strong> — เปิดมาก็เจอค่าที่ผ่านการพิสูจน์มาแล้วทันที ไม่ต้องมานั่งเดาว่าจะตั้งค่ายังไงให้ดี',
];

const releases = [
  { version: 'v3.11', dateLabel: '10 ก.ย. 2026', latest: true, url: DL_LATEST },
  { version: 'v3.10', dateLabel: '22 ส.ค. 2026', latest: false, url: DL_V310 },
  { version: 'v3.092', dateLabel: '19 ส.ค. 2026', latest: false, url: DL_V3092 },
  { version: 'v2.02', dateLabel: '13 ก.ค. 2026', latest: false, url: DL_V202 },
  { version: 'v2.01', dateLabel: '10 ก.ค. 2026', latest: false, url: DL_V201 },
  { version: 'v2.00', dateLabel: '8 ก.ค. 2026', latest: false, url: DL_V200 },
  { version: 'v1.37', dateLabel: '24 มิ.ย. 2026', latest: false, url: DL_V137 },
  { version: 'v1.18', dateLabel: '13 มิ.ย. 2026', latest: false, url: DL_V118 },
];

// file-list rows (github metaphor -> สารบัญ EA)
const fileRows = [
  { icon: 'doc', name: 'ภาพรวม gdBasket', note: 'Adaptive Buy Grid Behavior EA · ทยอยซื้อเป็นชุด ปิดรับกำไรทั้งชุด', meta: 'อ่าน', href: '#readme', color: 'text-gray' },
  { icon: 'gear', name: 'วิธีติดตั้ง', note: 'ลงใน MT5 · ลากใส่กราฟ GOLD M15 · 6 ขั้นจบ', meta: '6 ขั้น', href: '#install', color: 'text-secondary' },
  { icon: 'modes', name: 'เครื่องยนต์ VELOCE', note: 'ค่าพร้อมใช้ที่ผ่านการทดสอบมาแล้ว · ไม่ต้องเลือกโหมด', meta: 'พร้อมใช้', href: '#modes', color: 'text-primary' },
  { icon: 'star', name: 'จุดเด่น', note: 'Adaptive Grid / Market Temperature / PPTS / Common-TP', meta: 'อ่าน', href: '#features', color: 'text-primary' },
  { icon: 'risk', name: 'ความเสี่ยงที่ต้องรู้', note: 'Buy Grid · Capital · เงินค้ำ · ข้อจำกัดก่อนใช้', meta: 'สำคัญ', href: '#risk', color: 'text-secondary' },
  { icon: 'clock', name: 'Releases', note: 'v3.11 · v3.10 · v3.092 · v2.02 · v2.01 · v2.00 · v1.37 · v1.18', meta: '8 rel', href: '/ea/gdbasket/changelog', color: 'text-gray' },
  { icon: 'calc', name: 'วางแผนเงิน Rolling Capital', note: 'เครื่องคิดเลขถอน/ทบจากผลจริงย้อนหลัง', meta: 'ลองเลย', href: '/ea/gdbasket/rolling-capital', color: 'text-secondary' },
  { icon: 'dl', name: 'gdBasket v3.11', note: 'พร้อมใช้ · โหลดฟรี', meta: 'ดาวน์โหลด', href: DL_LATEST, color: 'text-green', download: true },
  { icon: 'journal', name: 'Trading Journal', note: 'ผลเทรดจริงรายวัน · กำไร/ขาดทุนต่อรอบ', meta: 'ดูประวัติ', href: JOURNAL, color: 'text-primary', accent: true },
];

const installSteps = [
  'ดาวน์โหลดไฟล์ <strong>gdBasket v3.11</strong> จากปุ่มด้านบน',
  'เปิด <strong>MetaTrader 5</strong> → <strong>File → Open Data Folder</strong>',
  'วางไฟล์ในโฟลเดอร์ <code class="install-path">MQL5 → Experts</code>',
  'ปิดเปิด MT5 ใหม่ หรือกด <strong>Refresh</strong> ใน Navigator',
  'ลาก <strong>gdBasket</strong> ใส่กราฟ <strong>GOLD M15</strong> → ติ๊กอนุญาตเทรดอัตโนมัติ → กดปุ่ม <strong>Algo Trading</strong> ให้ขึ้น<strong class="text-green">สีเขียว</strong>',
  'ตั้ง <strong>Capital</strong> = เงินที่ยอมเสียได้ต่อรอบ — Standard ขั้นต่ำ <strong>$1,000</strong> · Micro ขั้นต่ำ <strong>$100</strong> (ต่ำกว่านี้ EA จะไม่เปิดออเดอร์) และใช้ <strong>VELOCE</strong> ที่ตั้งมาให้พร้อมใช้ได้เลย',
];

