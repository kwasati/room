  <!-- v3.092 (demoted — supersede โดย v3.10, ยังกดโหลดได้ที่ลิงก์เฉพาะรุ่น) -->
  <section class="release">
    <div class="meta">
      <span class="ver"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 013 12V7a4 4 0 014-4z"/></svg><span class="pixel">v3.092</span></span>
